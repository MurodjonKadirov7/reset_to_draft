<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_reset_to_draft_sale" model="ir.actions.server">
        <field name="name">Reset to Draft</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="group_ids" eval="[(4, ref('reset_to_draft.group_reset_to_draft_sale'))]"/>
        <field name="code">action = records.action_open_reset_to_draft_wizard_multi()</field>
    </record>

    <record id="action_reset_to_draft_purchase" model="ir.actions.server">
        <field name="name">Reset to Draft</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="group_ids" eval="[(4, ref('reset_to_draft.group_reset_to_draft_purchase'))]"/>
        <field name="code">action = records.action_open_reset_to_draft_wizard_multi()</field>
    </record>

    <record id="action_reset_to_draft_stock" model="ir.actions.server">
        <field name="name">Reset to Draft</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="group_ids" eval="[(4, ref('reset_to_draft.group_reset_to_draft_sale')), (4, ref('reset_to_draft.group_reset_to_draft_purchase'))]"/>
        <field name="code">action = records.action_open_reset_to_draft_wizard_multi()</field>
    </record>

    <record id="action_reset_to_draft_mrp" model="ir.actions.server">
        <field name="name">Reset to Draft</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="group_ids" eval="[(4, ref('reset_to_draft.group_reset_to_draft_sale')), (4, ref('reset_to_draft.group_reset_to_draft_purchase'))]"/>
        <field name="code">action = records.action_open_reset_to_draft_wizard_multi()</field>
    </record>
</odoo>
